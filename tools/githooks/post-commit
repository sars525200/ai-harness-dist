#!/bin/sh
# harness 備份鏡像：每次 commit 後自動同步到 C 槽 NVMe 的 bare repo。
#   來源 D:\Patrick-AI\.ai-harness（Disk 0, SATA HDD）
#   鏡像 C:\Users\<USER>\git-mirrors\JEFF-Harness.git（Disk 1, NVMe SSD）
#
# ⚠ 這是**版控中的正本**。`.git/hooks/` 不進版控，換機器或重新 clone 都不會有它。
#   安裝：cp tools/githooks/post-commit .git/hooks/post-commit
#
# ── 為什麼要有這一版 ───────────────────────────────────────────────────────
# 舊版是 `git push -q backup --all 2>/dev/null || true`：刻意 fail-open（備份推不動
# 不該擋 commit），代價寫成註解「靠收工時順手看一眼」。
#
# 2026-09-02 量到那個代價實際是多少：**73 個 commit ／ 6 天完全沒備份**。
# 8/27 之後本機改寫過歷史 ⇒ 鏡像那顆變孤兒 ⇒ 之後每一次推送都被 non-fast-forward
# 拒絕，然後被 `2>/dev/null || true` 吃掉。沒有人「順手看一眼」，因為沒有東西提醒他要看。
#
# 這一版仍然 fail-open（不擋 commit），但把失敗**留下兩個痕跡**：
#   1. stderr 印一行警告 —— commit 當下就看得到
#   2. state/mirror_sync_failed.txt —— 給 tools/check_before_start.py [4] 之外的後手用
# 成功則刪掉標記，所以「檔案存在」＝「最後一次推送是失敗的」。
#
# 2026-09-07 再加一層：分叉但**內容零損失**時自動對齊（見下方 try_realign），
# 因為留下痕跡並沒有讓這件事變少 —— 09-02 之後又發生兩次。

set -u
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
MARK="$ROOT/state/mirror_sync_failed.txt"

# ── 雲端備份（2026-09-04 加）──────────────────────────────────────────────
# 清洗過的複製品推 GitHub private（tools/push_cloud_backup.py）。一輪 25 秒起跳，
# 所以**不在前景跑**：包裝器立刻回、背景推、結果落 state/cloud_backup_last.json，
# 失敗另寫 state/cloud_backup_failed.txt；開工檢查 [4] 會讀。規則檔不在時
# 推送工具會拒跑，那也算失敗、會留標記 —— 這裡刻意不預先判斷，讓失敗被看見。
if [ -f "$ROOT/tools/cloud_backup_hook.py" ]; then
    if command -v py >/dev/null 2>&1; then PY="py -3"; else PY="python3"; fi
    $PY "$ROOT/tools/cloud_backup_hook.py" --spawn 2>&1 | head -2 >&2 || true
fi

# ── 記憶備份（2026-09-05 加）──────────────────────────────────────────────
# Claude Code 的記憶檔在使用者目錄、不在任何 repo 裡 —— 換機器就沒了，而且不會有
# 提示。2026-09-05 盤點時 harness 自己那份是零備份。
#
# 它走**獨立的 repo**（位置寫在 harness.config.json 的 memoryRepo），刻意不接進
# 這個 repo：這個 repo 每次 commit 都自動推雲端，記憶不該上去。走獨立 repo 是為了
# 「根本沒有那條路」，而不是靠某個設定擋著 —— 靠設定擋的東西，改錯了不會有人知道。
#
# 一輪 1 秒內（本機小 repo 的 commit ＋ push），所以前景跑，不需要背景與鎖。
# 沒設定就安靜跳過；設定了卻壞掉會落 state/memory_backup_failed.txt。
if [ -f "$ROOT/tools/memory_backup_hook.py" ]; then
    if command -v py >/dev/null 2>&1; then MPY="py -3"; else MPY="python3"; fi
    $MPY "$ROOT/tools/memory_backup_hook.py" --run --quiet >/dev/null 2>&1 || true
fi

git remote | grep -qx backup || exit 0

# ── 同內容改寫 → 自動對齊（2026-09-07 加）────────────────────────────────
# 2026-09-02 / 09-06 / 09-07 三次分叉，成因每次都一樣：某則對話 commit 之後
# 幾十秒內又 amend 同一顆，而這支 hook 在那幾十秒內已經把**改之前**那顆推進
# 鏡像了。改之後的那顆換了 sha ⇒ 從此每一次推送都 non-fast-forward 被拒。
#
# 前一次修的只是「讓失敗被看見」，沒有處理成因，所以它每隔幾天就再來一次；
# 而人工處理一次要挖十分鐘（確認鏡像那顆是不是真的沒有獨有內容）。這裡把那個
# 確認寫成程式：
#
#   **只有在「鏡像獨有的每一顆 commit，其檔案樹都能在本機找到同樣一份」時才對齊。**
#
# 綁的是後果（有沒有內容只存在於鏡像），不是成因（是不是 amend 造成的）——
# 所以 rebase、cherry-pick、squash 只要沒弄丟內容，一樣自動過；反過來只要有
# 任何一份內容只在鏡像裡，就一律不碰、照舊大聲失敗。對齊成功也會留痕跡，
# 不是靜默 force。
try_realign() {
    git fetch -q backup "+refs/heads/*:refs/remotes/_mirror/*" 2>/dev/null || return 1
    _did=0
    for _ref in $(git for-each-ref --format='%(refname:short)' refs/remotes/_mirror/); do
        _br=${_ref#_mirror/}
        # 鏡像有、本機沒有的分支：整支放棄自動處理（可能是別台機器推的）。
        git show-ref --verify -q "refs/heads/$_br" || return 1
        _r=$(git rev-parse "$_ref") || return 1
        _l=$(git rev-parse "$_br") || return 1
        [ "$_r" = "$_l" ] && continue
        git merge-base --is-ancestor "$_r" "$_l" && continue   # 純落後，一般 push 就會過
        _only=$(git rev-list "$_r" --not "$_l" | while read -r c; do git rev-parse "$c^{tree}"; done | sort -u)
        [ -n "$_only" ] || return 1
        _mine=$(git rev-list "$_l" --not "$_r" | while read -r c; do git rev-parse "$c^{tree}"; done | sort -u)
        for _t in $_only; do
            printf '%s\n' "$_mine" | grep -qx "$_t" || return 1
        done
        git push -q --force-with-lease="$_br:$_r" backup "$_br" 2>/dev/null || return 1
        echo "$(date '+%Y-%m-%d %H:%M:%S')  $_br  $_r -> $_l  （鏡像獨有的 commit 內容在本機都有，已對齊）" \
            >> "$ROOT/state/mirror_realigned.log" 2>/dev/null
        _did=1
    done
    [ "$_did" = 1 ]
}

# ── 拒絕對齊時，標記檔要講清楚（2026-09-08 加）─────────────────────────────
# 2026-09-08 實踩：另一則對話在自己分支上把一顆 commit 改寫（拿掉自動遞增的版號檔），
# 鏡像留的是舊版 ⇒ try_realign 正確地拒絕（內容不同）⇒ 之後每一顆 commit 都紅。
# 但標記檔只貼 git 原文，讀起來像「主線沒備份」，人要挖十分鐘才知道：主線其實
# 推成功了、紅的是哪條分支、鏡像多了哪顆、該貼哪三行。挖過一次的東西就寫成程式。
# 這裡**不做決定**（蓋不蓋還是人判），只把判斷需要的事實與指令放進標記檔。
diagnose() {
    git fetch -q backup "+refs/heads/*:refs/remotes/_mirror/*" 2>/dev/null || { echo "（鏡像連不上，無法診斷）"; return; }
    _cur=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    _head=$(git rev-parse HEAD 2>/dev/null)
    if [ "$(git rev-parse "_mirror/$_cur" 2>/dev/null)" = "$_head" ]; then
        echo "這顆 commit（$_cur）已經在鏡像上——紅的是下面的分支，不是這顆。"
    else
        echo "這顆 commit（$_cur）沒推上鏡像。"
    fi
    for _ref in $(git for-each-ref --format='%(refname:short)' refs/remotes/_mirror/); do
        _br=${_ref#_mirror/}
        if ! git show-ref --verify -q "refs/heads/$_br"; then
            echo
            echo "分支 $_br：鏡像有、本機沒有（可能別台機器推的）——不自動處理"
            continue
        fi
        _r=$(git rev-parse "$_ref") || continue
        _l=$(git rev-parse "$_br") || continue
        [ "$_r" = "$_l" ] && continue
        git merge-base --is-ancestor "$_r" "$_l" && continue
        echo
        echo "分支 $_br 分叉：鏡像 $(git rev-parse --short "$_r")，本機 $(git rev-parse --short "$_l")"
        echo "鏡像獨有的 commit（本機找不到同樣的檔案樹，所以沒自動蓋）："
        git log --format='  %h %s' "$_r" --not "$_l"
        echo "鏡像那份 vs 本機那份：$(git diff --shortstat "$_r" "$_l")"
        echo "看過差異、確定本機那份是對的，貼這三行（舊 tip 先用 tag 留住，不會弄丟）："
        _tag="keep/$(printf '%s' "$_br" | tr '/' '-')-$(git rev-parse --short "$_r")-$(date '+%Y%m%d')"
        echo "  git tag $_tag $_r && git push -q backup $_tag"
        echo "  git push -q --force-with-lease=$_br:$_r backup $_br"
        echo "  git push -q backup --all && rm -f state/mirror_sync_failed.txt"
    done
}

ERR=$(git push -q backup --all 2>&1)
if [ $? -eq 0 ]; then
    rm -f "$MARK"
    exit 0
fi

mkdir -p "$ROOT/state" 2>/dev/null
if try_realign; then
    ERR=$(git push -q backup --all 2>&1)
    if [ $? -eq 0 ]; then
        rm -f "$MARK"
        echo "!! 鏡像曾分叉，已自動對齊（獨有內容 0 份）—— 紀錄 state/mirror_realigned.log" >&2
        exit 0
    fi
fi

DIAG=$(diagnose 2>&1)
{
    echo "最後一次鏡像推送失敗"
    echo "時間: $(date '+%Y-%m-%d %H:%M:%S')"
    echo "commit: $(git rev-parse HEAD)"
    echo "原因:"
    echo "$ERR"
    echo
    echo "診斷:"
    echo "$DIAG"
    echo
    echo "查現況: py -3 tools/check_before_start.py --no-vm"
} > "$MARK" 2>/dev/null

case "$DIAG" in
    *已經在鏡像上*) echo "!! 備份鏡像：這顆已推上，但有別的分支分叉沒對齊 —— 該貼的指令在 state/mirror_sync_failed.txt" >&2 ;;
    *)              echo "!! 備份鏡像推送失敗，這顆 commit 沒有備份 —— 詳情 state/mirror_sync_failed.txt" >&2 ;;
esac
echo "$ERR" | head -3 >&2

# fail-open：備份的問題不該讓 commit 看起來像失敗。
exit 0
