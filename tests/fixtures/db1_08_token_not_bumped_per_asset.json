{
  "name": "DB-1 改了 styles.css 卻只 bump app.js 的 token → BLOCK",
  "rule": "db1_deploy",
  "why": "慣例查證（git log 實測）：index.html 兩個 ?v= token **各自獨立 bump，只有改到該檔才升**——歷史上 styles.css 曾停在 2218 好幾個版本（177bb27e/cceec95d/e7eb78f1 皆為 [2218, 22xx]）。所以「兩處必須同值」是錯的規則（原 fixture 08 據此寫，已廢），而「整體有變即通過」會漏掉此情境：styles.css 改了但它的 token 沒動，該檔的瀏覽器快取不會被清掉，症狀是「改了但使用者看到舊樣式」——比完全沒 bump 更難查，因為 app.js 的部分生效了。",
  "payload": {
    "hook_event_name": "PreToolUse",
    "tool_name": "PowerShell",
    "tool_input": {
      "command": "git push vm master",
      "description": "部署"
    },
    "session_id": "fixture-db1-08",
    "cwd": "D:\\IT-department",
    "permission_mode": "auto"
  },
  "git": {
    "remote_ref": "vm/master",
    "diff_names": {
      "vm/master..HEAD": [
        "SOP_PROD/05_UI_Demo/app.js",
        "SOP_PROD/05_UI_Demo/styles.css",
        "SOP_PROD/05_UI_Demo/index.html"
      ]
    },
    "status_paths": [],
    "show": {
      "vm/master:SOP_PROD/05_UI_Demo/index.html": "<link rel=\"stylesheet\" href=\"/styles.css?v=2224\" />\n<script src=\"/app.js?v=2224\"></script>",
      "HEAD:SOP_PROD/05_UI_Demo/index.html": "<link rel=\"stylesheet\" href=\"/styles.css?v=2224\" />\n<script src=\"/app.js?v=2225\"></script>"
    }
  },
  "expect": {
    "decision": "BLOCK",
    "message_contains": "styles.css"
  }
}
