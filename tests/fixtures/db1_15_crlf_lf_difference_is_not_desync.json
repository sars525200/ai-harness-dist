{
  "name": "DB-1 兩端內容相同、只有行尾 CRLF/LF 不同 → ALLOW",
  "rule": "db1_deploy",
  "why": "2026-07-29（0b）改成比內容之後才會踩到的雷：D12 做過 `.gitattributes` renormalize，git blob 存 LF、Windows 工作區是 CRLF。若比對前不先統一行尾，同一份內容在 blob 與 worktree 之間**永遠不相等** → 每一次部署都被誤 BLOCK。此 fixture 讓 PROD 側 blob 帶 CRLF、DEV 側帶 LF，其餘逐字相同，規則必須視為已同步。反向保證見 db1_05（真的內容不同時仍要擋）。",
  "payload": {
    "hook_event_name": "PreToolUse",
    "tool_name": "PowerShell",
    "tool_input": {
      "command": "git push vm master",
      "description": "部署"
    },
    "session_id": "fixture-db1-15",
    "cwd": "D:\\IT-department",
    "permission_mode": "auto"
  },
  "git": {
    "remote_ref": "vm/master",
    "diff_names": {
      "vm/master..HEAD": [
        "SOP_PROD/05_UI_Demo/app.js",
        "SOP_PROD/05_UI_Demo/index.html"
      ]
    },
    "status_paths": [],
    "show": {
      "vm/master:SOP_PROD/05_UI_Demo/index.html": "<link rel=\"stylesheet\" href=\"/styles.css?v=2224\" />\n<script src=\"/app.js?v=2224\"></script>",
      "HEAD:SOP_PROD/05_UI_Demo/index.html": "<link rel=\"stylesheet\" href=\"/styles.css?v=2224\" />\n<script src=\"/app.js?v=2225\"></script>"
    },
    "syntax_errors": {},
    "show_bytes": {
      "HEAD:SOP_PROD/05_UI_Demo/app.js": "function boot() {\r\n  return 'v2';\r\n}\r\n",
      "HEAD:SOP_PROD/05_UI_Demo/index.html": "<link rel=\"stylesheet\" href=\"/styles.css?v=2224\" />\r\n<script src=\"/app.js?v=2225\"></script>"
    }
  },
  "dev_git": {
    "remote_ref": null,
    "diff_names": {
      "HEAD~1..HEAD": [
        "05_UI_Demo/app.js",
        "05_UI_Demo/index.html"
      ]
    },
    "status_paths": [],
    "syntax_errors": {},
    "show_bytes": {
      "HEAD:05_UI_Demo/app.js": "function boot() {\n  return 'v2';\n}\n",
      "HEAD:05_UI_Demo/index.html": "<link rel=\"stylesheet\" href=\"/styles.css?v=2224\" />\n<script src=\"/app.js?v=2225\"></script>"
    }
  },
  "expect": {
    "decision": "ALLOW"
  }
}
