{
  "name": "PR-1 這輪動的不是 *_PLAN.md → ALLOW",
  "why": "觸發範圍要收緊。這條防的是把任何 .md 都當計畫書檢查——那會讓每次改 memory/*.md 都被擋。",
  "workspace": {
    "files": {
      "NOTES.md": "# 測試計畫書\n\n> 狀態：待審核\n\n## §1 現況\n\n這裡是內容。\n"
    },
    "transcript": [
      {
        "type": "user",
        "message": {
          "content": "幫我把這份計畫書寫一寫"
        }
      },
      {
        "type": "assistant",
        "message": {
          "content": [
            {
              "type": "tool_use",
              "name": "Write",
              "input": {
                "file_path": "<DIR>/NOTES.md",
                "content": "..."
              }
            }
          ]
        }
      },
      {
        "type": "user",
        "message": {
          "content": [
            {
              "type": "tool_result",
              "content": "File created"
            }
          ]
        }
      }
    ]
  },
  "payload": {
    "hook_event_name": "Stop",
    "session_id": "fx-pr1",
    "transcript_path": "<TRANSCRIPT>",
    "cwd": "<DIR>",
    "stop_hook_active": false
  },
  "expect": {
    "decision": "ALLOW"
  },
  "rule": "pr1_plan_review_marker"
}