      {
        "matcher": "clear|logout|prompt_input_exit|other",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"D:\\Patrick-AI\\.ai-harness\\hooks\\session_archive.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Skill|Write|Edit|MultiEdit|NotebookEdit|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"D:\\Patrick-AI\\.ai-harness\\hooks\\dispatch.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"D:\\Patrick-AI\\.ai-harness\\hooks\\dispatch.py\""
          }
        ]
      }
    ],
